# Supabase (Project Settings > API) — plano gratuito
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pl@ntNet — identificação da planta pela foto
# Crie uma conta gratuita em https://my.plantnet.org/ e gere uma API key
PLANTNET_API_KEY=
# Projeto de identificação do Pl@ntNet. "all" cobre o mundo todo.
PLANTNET_PROJECT=all

# Google Gemini — geração das dicas de cuidado
# Crie uma API key gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
